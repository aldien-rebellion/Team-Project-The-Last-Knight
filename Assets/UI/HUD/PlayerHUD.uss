.hud-root {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 30%;
    max-width: 350px;
}

.hud-container {
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 5px;
}

.stat-row {
    flex-direction: column;
    margin-bottom: 8px;
}

.stat-label {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.bar-container {
    height: 15px;
    background-color: rgba(0, 0, 0, 0.8);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    width: 100%;
    transform-origin: left;
}

.health-fill {
    background-color: rgb(200, 40, 40);
}

.exp-fill {
    background-color: rgb(40, 150, 200);
}

.level-container {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.level-text {
    color: rgb(255, 215, 0); /* Gold */
    font-size: 18px;
    -unity-font-style: bold;
}

.hp-value-text {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
}
